# Backend sozlamalari (nusxa oling: cp .env.example .env)
NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://edu:edu_dev_pass@localhost:5432/edu
# Frontend manzili (CORS va Socket.IO uchun)
APP_ORIGIN=http://localhost:5173
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=25
SESSION_DAYS=7
# Productionda HTTPS orqali ishlaganda true bo'lsin (secure cookie)
COOKIE_SECURE=false
# Nginx/proxy ortida ishlaganda 1
TRUST_PROXY=0
